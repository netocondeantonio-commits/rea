FROM node:24-bookworm-slim
USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
  && rm -rf /var/lib/apt/lists/*
USER node
WORKDIR /opt/rea
# The repository and engine directories are mounted when the admin page runs docker.
CMD ["node", "scripts/rea.mjs", "--help"]
