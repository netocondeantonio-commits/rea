# Copy to deploy/.env. Do not commit real passwords or tokens.

REA_ADMIN_USER=admin
REA_ADMIN_PASSWORD=change-me-please
# REA_ADMIN_TOKEN=
# REA_ADMIN_SESSION_SECRET=

# The process listens on 0.0.0.0:4174 inside the container.
# Compose does not publish 80 or 443. Traefik, on the host network, reaches 4174.
REA_BIND=0.0.0.0
REA_ANALYZE_PORT=4174
REA_TRUST_PROXY=1
REA_COOKIE_SECURE=1
# REA_CORS_ORIGIN=

# Production default: isolate inside the container (no network, taskset, prlimit).
REA_SANDBOX=1
REA_SANDBOX_MODE=isolate
REA_SANDBOX_MEMORY_MB=2048
# REA_SANDBOX_MODE=docker

REA_TRAEFIK_ENABLE=true
REA_TRAEFIK_HOST=rea-187-77-225-72.sslip.io
REA_TRAEFIK_ENTRYPOINT=websecure
REA_TRAEFIK_CERTRESOLVER=letsencrypt

# REA_DEMO=1
# REA_DEMO_PASSWORD=
# REA_UPLOAD_MAX_BYTES=41943040
