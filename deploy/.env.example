# Copy to deploy/.env. Do not commit real passwords or tokens.

REA_ADMIN_USER=admin
REA_ADMIN_PASSWORD=change-me-please
# REA_ADMIN_TOKEN=
# REA_ADMIN_SESSION_SECRET=

# Inside the container the process listens on 0.0.0.0:4174.
# Compose publishes that port only on 127.0.0.1. Do not use 80 or 443.
REA_BIND=0.0.0.0
REA_ANALYZE_PORT=4174
# REA_TRUST_PROXY=1
# REA_CORS_ORIGIN=
# REA_COOKIE_SECURE=1

# REA_SANDBOX=1
# REA_DEMO=1
# REA_DEMO_PASSWORD=
# REA_UPLOAD_MAX_BYTES=41943040
