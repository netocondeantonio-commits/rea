# Local admin example. Copy to .env in the repository root or to
# ~/.local/share/rea/admin.env. Do not commit a real password.
# Values already set in the environment are kept. Nothing is expanded as a shell.

REA_ADMIN_USER=admin
REA_ADMIN_PASSWORD=change-me-please

# Optional. At least 16 characters. Scripts send: Authorization: Bearer <token>
# The token can start and read analyses. It cannot create users or change engines.
# REA_ADMIN_TOKEN=

# Optional. At least 16 characters. When empty, the page stores its own secret.
# REA_ADMIN_SESSION_SECRET=

# REA_ANALYZE_PORT=4174
# REA_ANALYZE_OUTPUT=
# REA_ADMIN_DIR=
