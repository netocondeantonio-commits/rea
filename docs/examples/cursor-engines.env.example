# Copy is unnecessary. scripts/install-free-analysis-engines.mjs writes the
# real file to $HOME/.local/share/rea/cursor-engines.env. Paths below are
# placeholders. Leave the Hopper and IDA lines commented until those engines
# are installed and licensed.

export GHIDRA_INSTALL_DIR='/absolute/path/to/ghidra_12.1.4_PUBLIC'
export JAVA_HOME='/absolute/path/to/jdk-21'
export REA_JADX_MCP_JAR='/absolute/path/to/jadx-headless-mcp-0.7.1-all.jar'
export REA_RIZIN_COMMAND='/absolute/path/to/rizin'
export REA_OBJDUMP_COMMAND='/absolute/path/to/objdump'
export REA_GDB_COMMAND='/absolute/path/to/gdb'
export GHIDRA_MCP_BIN='/absolute/path/to/ghidra-mcp'
export GHIDRA_MCP_EXTENSION_ZIP='/absolute/path/to/ghidra_12.1.4_PUBLIC_20261010_GhidraMCP.zip'
export GHIDRA_MCP_SERVER='http://127.0.0.1:8080/'

# Paid engines are not installed. Fill these stubs before using them:
# export HOPPER_LAUNCHER_PATH='/absolute/path/to/hopper'
# export REA_IDA_MCP_CONFIG='/absolute/path/to/ida-mcp.json'
